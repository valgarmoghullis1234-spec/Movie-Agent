# ---- Anthropic (Claude) ----
# Get a key: https://console.anthropic.com/  (leave blank to run in echo/mock mode)
ANTHROPIC_API_KEY=
# Fallback/echo model only. Each agent picks its own model in app/agents/definitions.py
# (router/plot/reviews = Haiku, recommender = Sonnet), so this line does not affect them.
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Langfuse (observability / tracing / prompt registry) ----
# Get keys: https://cloud.langfuse.com/  (leave blank to disable tracing — app still runs)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- TMDB (movie data — used from Phase 1) ----
TMDB_API_KEY=

# ---- OMDb (fallback data source + IMDb/RT/Metacritic ratings) ----
# Free key: https://www.omdbapi.com/apikey.aspx  (used when TMDB is slow/blocked,
# and as the source of cross-site ratings for the Reviews agent)
OMDB_API_KEY=

# ---- Server ----
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000
